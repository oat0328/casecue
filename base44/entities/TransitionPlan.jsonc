{
  "name": "TransitionPlan",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "interests": {
      "type": "string",
      "title": "Interests and Preferences"
    },
    "strengths": {
      "type": "string",
      "title": "Transition Strengths"
    },
    "education_goal": {
      "type": "string",
      "title": "Postsecondary Education/Training Goal"
    },
    "employment_goal": {
      "type": "string",
      "title": "Employment Goal"
    },
    "independent_living_goal": {
      "type": "string",
      "title": "Independent Living Goal"
    },
    "assessment_summary": {
      "type": "string",
      "title": "Transition Assessment Summary"
    },
    "student_voice": {
      "type": "string",
      "title": "Student Voice"
    },
    "activities": {
      "type": "string",
      "title": "Transition Activities"
    },
    "agency_participation": {
      "type": "string",
      "title": "Agency Participation"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "active"
      ],
      "default": "draft",
      "title": "Status"
    }
  },
  "required": [
    "student_id",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}