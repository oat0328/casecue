{
  "name": "SupplementaryAid",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "aid_service": {
      "type": "string",
      "title": "Supplementary Aid / Service"
    },
    "condition": {
      "type": "string",
      "title": "Condition / When Used"
    },
    "frequency": {
      "type": "string",
      "title": "Frequency"
    },
    "location": {
      "type": "string",
      "title": "Location / Setting"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "source_document_id": {
      "type": "string",
      "title": "Source IEP Document ID"
    },
    "source_page": {
      "type": "number",
      "title": "Source Page"
    },
    "teacher_verified": {
      "type": "boolean",
      "default": false,
      "title": "Teacher Verified"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "student_id",
    "organization_id",
    "aid_service"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}