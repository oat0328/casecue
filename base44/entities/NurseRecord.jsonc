{
  "name": "NurseRecord",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "provider_user_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "student_name_snapshot": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "health_office_visit",
        "vision",
        "hearing",
        "screening",
        "follow_up",
        "evaluation_support",
        "other"
      ],
      "default": "health_office_visit"
    },
    "observed_result": {
      "type": "string"
    },
    "objective_note": {
      "type": "string"
    },
    "follow_up": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "complete"
      ],
      "default": "complete"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "provider_user_id",
    "date",
    "record_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.provider_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}