{
  "name": "WeeklyFamilyUpdate",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "workspace": {
      "type": "string",
      "enum": [
        "para",
        "sped",
        "gen_ed"
      ]
    },
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "week_start": {
      "type": "string",
      "format": "date"
    },
    "week_end": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "shared"
      ],
      "default": "draft"
    },
    "subject_line": {
      "type": "string"
    },
    "family_message": {
      "type": "string"
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "focus_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    },
    "chart_data": {
      "type": "object"
    },
    "source_counts": {
      "type": "object"
    },
    "generated_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "workspace",
    "student_id",
    "week_start",
    "week_end",
    "family_message"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}