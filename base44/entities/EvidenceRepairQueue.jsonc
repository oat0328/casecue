{
  "name": "EvidenceRepairQueue",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "work_evidence_id": {
      "type": "string",
      "title": "Work Evidence ID"
    },
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "title": {
      "type": "string",
      "title": "Work Title"
    },
    "reason": {
      "type": "string",
      "title": "Repair Reason"
    },
    "status": {
      "type": "string",
      "enum": [
        "needs_source_reupload",
        "resolved"
      ],
      "default": "needs_source_reupload",
      "title": "Status"
    }
  },
  "required": [
    "organization_id",
    "work_evidence_id",
    "student_id",
    "title"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}