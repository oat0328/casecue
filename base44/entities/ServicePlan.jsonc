{
  "name": "ServicePlan",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "service_type": {
      "type": "string",
      "title": "Service / SDI Area"
    },
    "minutes": {
      "type": "number",
      "title": "Minutes"
    },
    "frequency": {
      "type": "string",
      "title": "Frequency"
    },
    "period": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "month",
        "quarter",
        "other"
      ],
      "title": "Minute Period"
    },
    "setting": {
      "type": "string",
      "title": "Setting"
    },
    "delivery_model": {
      "type": "string",
      "enum": [
        "pull_out",
        "push_in",
        "consultation",
        "related_service",
        "other"
      ],
      "title": "Delivery Model"
    },
    "provider_role": {
      "type": "string",
      "title": "Provider Role"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "End Date"
    },
    "source_document_id": {
      "type": "string",
      "title": "Source IEP Document ID"
    },
    "source_page": {
      "type": "number",
      "title": "Source Page"
    },
    "teacher_verified": {
      "type": "boolean",
      "default": false,
      "title": "Teacher Verified"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "student_id",
    "organization_id",
    "service_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}