{
  "name": "ProgressData",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "goal_id": {
      "type": "string",
      "title": "Goal ID"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "correct": {
      "type": "number",
      "title": "Correct"
    },
    "total": {
      "type": "number",
      "title": "Total"
    },
    "percentage": {
      "type": "number",
      "title": "Percentage"
    },
    "decimal": {
      "type": "number",
      "title": "Decimal"
    },
    "qualitative_notes": {
      "type": "string",
      "title": "Qualitative Notes"
    },
    "prompting_level": {
      "type": "string",
      "enum": [
        "independent",
        "verbal",
        "visual",
        "physical",
        "full"
      ],
      "default": "independent",
      "title": "Prompting Level"
    },
    "support_level": {
      "type": "string",
      "title": "Support Level"
    },
    "observation_notes": {
      "type": "string",
      "title": "Observation Notes"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "work_evidence_id": {
      "type": "string",
      "title": "Linked Work Evidence ID"
    },
    "record_status": {
      "type": "string",
      "enum": [
        "active",
        "duplicate",
        "superseded"
      ],
      "default": "active",
      "title": "Record Status"
    },
    "data_basis": {
      "type": "string",
      "enum": [
        "goal_aligned_subset",
        "overall_assignment_score"
      ],
      "title": "Data Basis"
    },
    "duplicate_of_progress_id": {
      "type": "string",
      "title": "Duplicate Of Progress Data ID"
    }
  },
  "required": [
    "student_id",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}