{
  "name": "IepCycle",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "title": {
      "type": "string",
      "title": "Cycle Title"
    },
    "cycle_type": {
      "type": "string",
      "enum": [
        "annual",
        "interim",
        "reevaluation",
        "initial",
        "amendment",
        "other"
      ],
      "default": "annual",
      "title": "Cycle Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "drafting",
        "meeting_ready",
        "meeting_complete",
        "finalized",
        "archived"
      ],
      "default": "planning",
      "title": "Status"
    },
    "meeting_date": {
      "type": "string",
      "format": "date",
      "title": "Meeting Date"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "Start Date"
    },
    "finalized_date": {
      "type": "string",
      "format": "date",
      "title": "Finalized Date"
    },
    "previous_iep_document_id": {
      "type": "string",
      "title": "Previous IEP Document"
    },
    "draft_iep_document_id": {
      "type": "string",
      "title": "Draft IEP Document"
    },
    "final_iep_document_id": {
      "type": "string",
      "title": "Final IEP Document"
    },
    "workspace_id": {
      "type": "string",
      "title": "IEP Workspace ID"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    }
  },
  "required": [
    "student_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}