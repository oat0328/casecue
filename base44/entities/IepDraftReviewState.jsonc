{
  "name": "IepDraftReviewState",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "draft_artifact_id": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "educator_review_required",
        "in_review",
        "reviewed"
      ],
      "default": "educator_review_required"
    },
    "reviewed_at": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "draft_artifact_id"
  ]
}