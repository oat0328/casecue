{
  "name": "IepDraftReviewState",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "draft_artifact_id": {
      "type": "string"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "educator_review_required",
        "in_review",
        "reviewed"
      ],
      "default": "educator_review_required"
    },
    "reviewed_at": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "draft_artifact_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}