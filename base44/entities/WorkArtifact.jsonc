{
  "name": "WorkArtifact",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "batch_run_id": {
      "type": "string"
    },
    "artifact_key": {
      "type": "string"
    },
    "source_file_uri": {
      "type": "string"
    },
    "artifact_file_uri": {
      "type": "string"
    },
    "source_pages": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "detected_name": {
      "type": "string"
    },
    "probable_student_id": {
      "type": "string"
    },
    "probable_student_name": {
      "type": "string"
    },
    "identity_match_score": {
      "type": "number"
    },
    "student_id": {
      "type": "string"
    },
    "identity_status": {
      "type": "string",
      "enum": [
        "unmatched",
        "probable",
        "provisional",
        "teacher_confirmed"
      ],
      "default": "unmatched"
    },
    "assignment_title": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "grading",
        "review",
        "approved",
        "rejected",
        "duplicate"
      ],
      "default": "detected"
    },
    "scoring_confidence": {
      "type": "string"
    },
    "score_earned": {
      "type": "number"
    },
    "score_possible": {
      "type": "number"
    },
    "percentage": {
      "type": "number"
    },
    "grading_run_id": {
      "type": "string"
    },
    "work_evidence_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "batch_run_id",
    "artifact_key",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}