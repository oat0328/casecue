{
  "name": "AccommodationLog",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "accommodation": {
      "type": "string",
      "title": "Accommodation"
    },
    "status": {
      "type": "string",
      "enum": [
        "offered",
        "used",
        "declined",
        "not_applicable",
        "unable_to_provide"
      ],
      "title": "Implementation Status"
    },
    "context": {
      "type": "string",
      "title": "Context"
    },
    "effectiveness": {
      "type": "string",
      "title": "Effectiveness / Student Response"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "student_id",
    "organization_id",
    "date",
    "accommodation",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}