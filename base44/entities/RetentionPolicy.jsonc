{
  "name": "RetentionPolicy",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "student_record_years": {
      "type": "number",
      "default": 7,
      "title": "Student Record Retention Years"
    },
    "session_record_years": {
      "type": "number",
      "default": 7,
      "title": "Session Record Retention Years"
    },
    "document_years": {
      "type": "number",
      "default": 7,
      "title": "Document Retention Years"
    },
    "archive_exited_students": {
      "type": "boolean",
      "default": true,
      "title": "Archive Exited Students"
    },
    "delete_after_retention": {
      "type": "boolean",
      "default": false,
      "title": "Delete After Retention"
    },
    "notes": {
      "type": "string",
      "title": "Policy Notes"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date",
      "title": "Last Reviewed"
    }
  },
  "required": [
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}