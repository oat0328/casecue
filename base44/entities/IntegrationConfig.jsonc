{
  "name": "IntegrationConfig",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "integration_type": {
      "type": "string",
      "enum": [
        "SIS",
        "IEP_SYSTEM",
        "LMS",
        "CALENDAR",
        "OTHER"
      ],
      "title": "Integration Type"
    },
    "provider_name": {
      "type": "string",
      "title": "Provider Name"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_connected",
        "planning",
        "connected",
        "error"
      ],
      "default": "not_connected",
      "title": "Status"
    },
    "sync_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Sync Scope"
    },
    "last_sync_at": {
      "type": "string",
      "title": "Last Sync"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "organization_id",
    "integration_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}