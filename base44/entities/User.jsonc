{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "description": "The user's subscription plan",
      "enum": [
        "trial",
        "founding_teacher",
        "free"
      ],
      "default": "trial"
    },
    "organization_id": {
      "type": "string",
      "description": "The organization (tenant) this user belongs to"
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sped",
          "gen_ed",
          "psych",
          "speech",
          "ot",
          "para",
          "nurse",
          "substitute",
          "pe"
        ]
      },
      "description": "Workspace entitlements granted to this account"
    },
    "active_workspace": {
      "type": "string",
      "enum": [
        "sped",
        "gen_ed",
        "psych",
        "speech",
        "ot",
        "para",
        "nurse",
        "substitute",
        "pe"
      ],
      "description": "Workspace currently selected for this account"
    },
    "multi_workspace_access": {
      "type": "boolean",
      "default": false,
      "description": "True only when the subscription/admin assignment explicitly grants more than one workspace"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}