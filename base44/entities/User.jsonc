{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "plan": {
      "type": "string",
      "description": "The user's subscription plan",
      "enum": [
        "trial",
        "founding_teacher",
        "free"
      ],
      "default": "trial"
    },
    "organization_id": {
      "type": "string",
      "description": "The organization (tenant) this user belongs to"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}