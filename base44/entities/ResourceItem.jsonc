{
  "name": "ResourceItem",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "url": {
      "type": "string",
      "title": "URL"
    },
    "category": {
      "type": "string",
      "title": "Category"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "grade_band": {
      "type": "string",
      "title": "Grade Band"
    },
    "goal_area": {
      "type": "string",
      "title": "Goal Area"
    },
    "source": {
      "type": "string",
      "title": "Source"
    },
    "family_shareable": {
      "type": "boolean",
      "default": false,
      "title": "Family Shareable"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    }
  },
  "required": [
    "organization_id",
    "title"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}