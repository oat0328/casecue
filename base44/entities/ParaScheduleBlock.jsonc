{
  "name": "ParaScheduleBlock",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "para_user_id": {
      "type": "string"
    },
    "source_schedule_entry_id": {
      "type": "string"
    },
    "day": {
      "type": "string"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "group_name": {
      "type": "string"
    },
    "teacher_classroom": {
      "type": "string"
    },
    "delivery": {
      "type": "string"
    },
    "student_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "para_user_id"
  ],
  "rls": {
    "read": {
      "data.para_user_id": "{{user.id}}"
    },
    "create": {
      "data.para_user_id": "{{user.id}}"
    },
    "update": {
      "data.para_user_id": "{{user.id}}"
    },
    "delete": {
      "data.para_user_id": "{{user.id}}"
    }
  }
}