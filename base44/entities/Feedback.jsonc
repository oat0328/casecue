{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "feedback_type": {
      "type": "string",
      "enum": [
        "review",
        "feature_request",
        "bug_report",
        "general"
      ],
      "default": "general",
      "title": "Feedback Type"
    },
    "rating": {
      "type": "number",
      "title": "Rating (1-5 stars)"
    },
    "would_recommend": {
      "type": "number",
      "title": "Would Recommend (0-10)"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "body": {
      "type": "string",
      "title": "Feedback"
    },
    "feature_requested": {
      "type": "string",
      "title": "Feature Requested"
    },
    "browser_info": {
      "type": "string",
      "title": "Browser / Device Info"
    },
    "milestone": {
      "type": "string",
      "title": "Milestone That Prompted This"
    },
    "display_name": {
      "type": "string",
      "title": "Name to Show Publicly (optional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "planned",
        "in_progress",
        "completed",
        "closed"
      ],
      "default": "new",
      "title": "Status"
    },
    "approved_for_testimonial": {
      "type": "boolean",
      "default": false,
      "title": "Approved for Public Testimonial"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    }
  },
  "required": [
    "feedback_type",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.approved_for_testimonial": true
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}