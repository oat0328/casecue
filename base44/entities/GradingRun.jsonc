{
  "name": "GradingRun",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "goal_id": {
      "type": "string"
    },
    "source_file_uri": {
      "type": "string"
    },
    "source_work_evidence_id": {
      "type": "string"
    },
    "parent_run_id": {
      "type": "string"
    },
    "run_number": {
      "type": "number",
      "default": 1
    },
    "trigger": {
      "type": "string",
      "enum": [
        "initial",
        "teacher_regrade",
        "system_retry"
      ],
      "default": "initial"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "processing",
        "completed",
        "failed",
        "review_required",
        "approved",
        "rejected"
      ],
      "default": "queued"
    },
    "grader_version": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "assignment_title": {
      "type": "string"
    },
    "first_earned": {
      "type": "number"
    },
    "first_possible": {
      "type": "number"
    },
    "verified_earned": {
      "type": "number"
    },
    "verified_possible": {
      "type": "number"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "needs_teacher_review",
        "not_run"
      ],
      "default": "not_run"
    },
    "discrepancy_count": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "student_id",
    "status"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}