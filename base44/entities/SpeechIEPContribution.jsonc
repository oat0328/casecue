{
  "name": "SpeechIEPContribution",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "provider_user_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "present_levels": {
      "type": "string"
    },
    "strengths": {
      "type": "string"
    },
    "needs": {
      "type": "string"
    },
    "observations": {
      "type": "string"
    },
    "goal_drafts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_recommendation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "reviewed",
        "returned"
      ],
      "default": "draft"
    },
    "submitted_at": {
      "type": "string"
    },
    "review_note": {
      "type": "string"
    }
  },
  "required": [
    "provider_user_id",
    "student_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.provider_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}