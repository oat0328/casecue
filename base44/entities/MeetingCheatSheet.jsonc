{
  "name": "MeetingCheatSheet",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "workspace_id": {
      "type": "string",
      "title": "IEP Workspace ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in_meeting",
        "completed"
      ],
      "default": "draft",
      "title": "Status"
    },
    "current_step": {
      "type": "number",
      "default": 0,
      "title": "Current Step Index"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Meeting Steps"
    },
    "meeting_data": {
      "type": "object",
      "title": "Meeting Data (attendance, notes, decisions, summary)"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    }
  },
  "required": [
    "student_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}