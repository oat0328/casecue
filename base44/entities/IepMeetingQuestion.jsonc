{
  "name": "IepMeetingQuestion",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "meeting_id": {
      "type": "string"
    },
    "page_number": {
      "type": "number"
    },
    "question": {
      "type": "string"
    },
    "asked_by": {
      "type": "string"
    },
    "answer_or_resolution": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "answered",
        "follow_up"
      ],
      "default": "open"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    }
  },
  "required": [
    "student_id",
    "question",
    "status",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}
