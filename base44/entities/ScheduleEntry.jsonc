{
  "name": "ScheduleEntry",
  "type": "object",
  "properties": {
    "group_name": {
      "type": "string",
      "title": "Group Name"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "pull-out",
        "push-in",
        "consultation"
      ],
      "default": "pull-out",
      "title": "Delivery"
    },
    "day": {
      "type": "string",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday"
      ],
      "default": "Monday",
      "title": "Day"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "teacher_classroom": {
      "type": "string",
      "title": "Teacher / Classroom"
    },
    "service_minutes": {
      "type": "number",
      "title": "Service Minutes"
    },
    "student_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Student IDs"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "title": "Archived"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "week_pattern": {
      "type": "string",
      "enum": [
        "every_week",
        "A_week",
        "B_week",
        "alternating"
      ],
      "default": "every_week",
      "title": "Week Pattern"
    },
    "cycle_day": {
      "type": "string",
      "title": "Cycle Day / Rotation"
    },
    "period": {
      "type": "string",
      "title": "Period / Block"
    },
    "recurrence_note": {
      "type": "string",
      "title": "Recurrence Note"
    },
    "school_year": {
      "type": "string",
      "title": "School Year"
    }
  },
  "required": [
    "group_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}