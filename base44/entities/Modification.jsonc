{
  "name": "Modification",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "area": {
      "type": "string",
      "title": "Area"
    },
    "modification": {
      "type": "string",
      "title": "Modification"
    },
    "setting": {
      "type": "string",
      "title": "Setting"
    },
    "frequency": {
      "type": "string",
      "title": "Frequency"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    }
  },
  "required": [
    "student_id",
    "organization_id",
    "modification"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}