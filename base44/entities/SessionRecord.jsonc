{
  "name": "SessionRecord",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "start_time": {
      "type": "string",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "title": "End Time"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Duration (minutes, auto-calculated)"
    },
    "provider": {
      "type": "string",
      "title": "Provider"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "special_education",
        "general_education",
        "speech",
        "occupational_therapy",
        "physical_therapy",
        "counseling",
        "behavior_support",
        "other"
      ],
      "default": "special_education",
      "title": "Service Type"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "individual",
        "group"
      ],
      "default": "individual",
      "title": "Individual or Group"
    },
    "setting": {
      "type": "string",
      "enum": [
        "push_in",
        "pull_out"
      ],
      "default": "pull_out",
      "title": "Push-in or Pull-out"
    },
    "location": {
      "type": "string",
      "title": "Location"
    },
    "goal_id": {
      "type": "string",
      "title": "IEP Goal Addressed"
    },
    "activity": {
      "type": "string",
      "title": "Activity or Skill"
    },
    "scheduled_minutes": {
      "type": "number",
      "title": "Scheduled Minutes"
    },
    "delivered_minutes": {
      "type": "number",
      "title": "Delivered Minutes"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "partially_completed",
        "student_absent",
        "provider_absent",
        "school_activity",
        "refused",
        "rescheduled",
        "makeup_session",
        "canceled",
        "other"
      ],
      "default": "completed",
      "title": "Session Status"
    },
    "quantitative": {
      "type": "object",
      "title": "Quantitative Data"
    },
    "qualitative": {
      "type": "string",
      "title": "Qualitative Narrative"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Quick-Select Tags"
    },
    "follow_up_needed": {
      "type": "boolean",
      "default": false,
      "title": "Follow-Up Needed"
    },
    "follow_up_note": {
      "type": "string",
      "title": "Follow-Up Note"
    },
    "attachment_url": {
      "type": "string",
      "title": "Attachment URL"
    },
    "group_session_id": {
      "type": "string",
      "title": "Group Session ID"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "medicaid_billable": {
      "type": "boolean",
      "default": false,
      "title": "Medicaid Billable"
    },
    "billing_code": {
      "type": "string",
      "title": "Billing / Procedure Code"
    },
    "billing_units": {
      "type": "number",
      "title": "Billing Units"
    },
    "place_of_service": {
      "type": "string",
      "title": "Place of Service"
    },
    "provider_npi": {
      "type": "string",
      "title": "Provider NPI / Identifier"
    },
    "diagnosis_reference": {
      "type": "string",
      "title": "Diagnosis / Eligibility Reference"
    },
    "medical_necessity_note": {
      "type": "string",
      "title": "Medical Necessity / Service Note"
    },
    "signature_status": {
      "type": "string",
      "enum": [
        "not_required",
        "unsigned",
        "signed"
      ],
      "default": "not_required",
      "title": "Signature Status"
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "ready",
        "hold",
        "submitted",
        "paid",
        "denied"
      ],
      "default": "not_applicable",
      "title": "Billing Status"
    }
  },
  "required": [
    "student_id",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}