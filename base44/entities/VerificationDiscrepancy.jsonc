{
  "name": "VerificationDiscrepancy",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "grading_run_id": {
      "type": "string"
    },
    "problem_number": {
      "type": "string"
    },
    "discrepancy_type": {
      "type": "string",
      "enum": [
        "problem_text",
        "student_answer",
        "expected_answer",
        "score",
        "question_count",
        "total_points"
      ]
    },
    "pass_1_value": {
      "type": "string"
    },
    "pass_2_value": {
      "type": "string"
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "unresolved",
        "teacher_resolved",
        "system_resolved"
      ],
      "default": "unresolved"
    },
    "resolved_value": {
      "type": "string"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "grading_run_id",
    "discrepancy_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}