{
  "name": "IepEvidenceCoverage",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "present_level_items": {
      "type": "number"
    },
    "goal_items": {
      "type": "number"
    },
    "evaluation_items": {
      "type": "number"
    },
    "generated_at": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "document_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}