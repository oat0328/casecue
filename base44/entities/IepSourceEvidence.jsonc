{
  "name": "IepSourceEvidence",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "page_number": {
      "type": "number"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "present_level",
        "goal",
        "evaluation"
      ]
    },
    "text": {
      "type": "string"
    },
    "source_label": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "document_id",
    "evidence_type",
    "text"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}