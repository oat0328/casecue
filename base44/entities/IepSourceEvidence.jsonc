{
  "name": "IepSourceEvidence",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "page_number": {
      "type": "number"
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "present_level",
        "goal",
        "evaluation"
      ]
    },
    "text": {
      "type": "string"
    },
    "source_label": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "document_id",
    "evidence_type",
    "text"
  ]
}