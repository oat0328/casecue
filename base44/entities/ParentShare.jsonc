{
  "name": "ParentShare",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "label": {
      "type": "string",
      "title": "Share Label"
    },
    "token_hash": {
      "type": "string",
      "title": "Hashed Share Token"
    },
    "allowed_sections": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "academic_snapshot",
          "progress",
          "goals",
          "resources",
          "upcoming_meetings"
        ]
      },
      "title": "Allowed Sections"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active",
      "title": "Status"
    },
    "expires_at": {
      "type": "string",
      "title": "Expiration Date/Time"
    },
    "created_by_name": {
      "type": "string",
      "title": "Created By"
    },
    "last_accessed_at": {
      "type": "string",
      "title": "Last Accessed"
    },
    "access_count": {
      "type": "number",
      "default": 0,
      "title": "Access Count"
    },
    "include_last_name": {
      "type": "boolean",
      "default": false,
      "title": "Show Student Last Name"
    }
  },
  "required": [
    "student_id",
    "organization_id",
    "token_hash",
    "allowed_sections",
    "status",
    "expires_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}