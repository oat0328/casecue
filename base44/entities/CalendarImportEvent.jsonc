{
  "name": "CalendarImportEvent",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "ics",
        "googlecalendar",
        "outlook",
        "manual"
      ],
      "default": "ics"
    },
    "source_uid": {
      "type": "string"
    },
    "source_calendar": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "start_at": {
      "type": "string"
    },
    "end_at": {
      "type": "string"
    },
    "source_date": {
      "type": "string"
    },
    "source_timezone": {
      "type": "string"
    },
    "is_all_day": {
      "type": "boolean",
      "default": false
    },
    "location": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "meeting_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "meeting",
        "deadline",
        "school",
        "personal",
        "other"
      ],
      "default": "other"
    },
    "last_imported_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "user_id",
    "title",
    "start_at"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}