{
  "name": "Document",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "filename": {
      "type": "string",
      "title": "Filename"
    },
    "file_url": {
      "type": "string",
      "title": "File URL or Private URI"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "IEP",
        "Evaluation",
        "Eligibility Report",
        "BIP",
        "FBA",
        "504",
        "Progress Report",
        "Assessment Report",
        "Report Card",
        "Teacher Input",
        "Parent Input",
        "Service Provider Report",
        "Transition Assessment",
        "Other"
      ],
      "default": "Other",
      "title": "Document Type"
    },
    "date_uploaded": {
      "type": "string",
      "format": "date",
      "title": "Date Uploaded"
    },
    "uploaded_by": {
      "type": "string",
      "title": "Uploaded By"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "title": "Stored Privately"
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "processing",
        "ocr_processing",
        "processed",
        "failed"
      ],
      "default": "pending",
      "title": "Extraction Status"
    },
    "error_reason": {
      "type": "string",
      "title": "Processing Error Reason"
    },
    "last_attempted": {
      "type": "string",
      "title": "Last Processing Attempt"
    },
    "processing_results": {
      "type": "object",
      "title": "Saved OCR / Extraction Results"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "none",
        "passed",
        "flagged"
      ],
      "default": "none",
      "title": "Review Status"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    }
  },
  "required": [
    "filename"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}