{
  "name": "Lesson",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "objective": {
      "type": "string",
      "title": "Objective"
    },
    "essential_question": {
      "type": "string",
      "title": "Essential Question"
    },
    "real_world_connection": {
      "type": "string",
      "title": "Real-World Connection"
    },
    "mini_lecture": {
      "type": "string",
      "title": "Mini-Lecture"
    },
    "warm_up": {
      "type": "string",
      "title": "Warm-Up"
    },
    "i_do": {
      "type": "string",
      "title": "I Do"
    },
    "we_do": {
      "type": "string",
      "title": "We Do"
    },
    "you_do": {
      "type": "string",
      "title": "You Do"
    },
    "accommodations": {
      "type": "string",
      "title": "Accommodations"
    },
    "data_collection": {
      "type": "string",
      "title": "Data Collection"
    },
    "student_performance": {
      "type": "string",
      "title": "Student Performance"
    },
    "reflection": {
      "type": "string",
      "title": "Reflection"
    },
    "student_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Student IDs"
    },
    "source": {
      "type": "string",
      "enum": [
        "assignment",
        "topic"
      ],
      "default": "assignment",
      "title": "Created From"
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "grade": {
      "type": "string",
      "title": "Grade or Class"
    },
    "group_label": {
      "type": "string",
      "title": "Instructional Group Label"
    },
    "duration_minutes": {
      "type": "number",
      "title": "Estimated Duration (minutes)"
    },
    "goal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Related IEP Goal IDs"
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "State / Common Core Standards"
    },
    "analysis": {
      "type": "object",
      "title": "Assignment Analysis"
    },
    "plan": {
      "type": "object",
      "title": "Full Lesson Plan (structured)"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "video_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "usage_point": {
            "type": "string"
          },
          "added_by": {
            "type": "string"
          },
          "added_at": {
            "type": "string"
          }
        }
      },
      "title": "Approved Instructional Videos"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "site": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "licensing": {
            "type": "string"
          },
          "added_at": {
            "type": "string"
          }
        }
      },
      "title": "Saved Resource Links"
    },
    "practice_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "material_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "answer_key": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "title": "Original Practice Materials"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved"
      ],
      "default": "draft",
      "title": "Status"
    },
    "is_template": {
      "type": "boolean",
      "default": false,
      "title": "Saved As Template"
    },
    "audit_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      },
      "title": "Audit Trail (generated / edited / approved / exported)"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}