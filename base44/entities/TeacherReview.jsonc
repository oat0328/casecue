{
  "name": "TeacherReview",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "grading_run_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "approved_with_changes",
        "returned_for_regrade",
        "rejected"
      ]
    },
    "original_earned": {
      "type": "number"
    },
    "original_possible": {
      "type": "number"
    },
    "final_earned": {
      "type": "number"
    },
    "final_possible": {
      "type": "number"
    },
    "teacher_notes": {
      "type": "string"
    },
    "final_problem_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "grading_run_id",
    "student_id",
    "decision"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}