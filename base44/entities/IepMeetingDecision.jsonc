{
  "name": "IepMeetingDecision",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "meeting_id": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "agreed",
        "deferred",
        "needs_follow_up"
      ],
      "default": "open"
    },
    "notes": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    }
  },
  "required": [
    "student_id",
    "topic",
    "status",
    "organization_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}
