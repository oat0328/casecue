{
  "name": "WorkspaceNote",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "workspace": {
      "type": "string",
      "enum": [
        "para",
        "speech",
        "ot",
        "substitute",
        "pe",
        "gen_ed"
      ]
    },
    "student_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "behavior",
        "assessment",
        "academic_support",
        "push_in",
        "pull_out",
        "session",
        "communication",
        "handoff",
        "incident",
        "other"
      ]
    },
    "setting": {
      "type": "string"
    },
    "support_level": {
      "type": "string"
    },
    "attachment_url": {
      "type": "string"
    },
    "original_filename": {
      "type": "string"
    },
    "ai_cleaned": {
      "type": "boolean",
      "default": false
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "workspace",
    "body"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}