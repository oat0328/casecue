{
  "name": "WorkspaceNote",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "workspace": {
      "type": "string",
      "enum": [
        "para",
        "substitute",
        "pe"
      ]
    },
    "student_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "workspace",
    "body"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}