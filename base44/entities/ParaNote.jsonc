{
  "name": "ParaNote",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "context": {
      "type": "string",
      "enum": [
        "classroom",
        "assessment",
        "transition",
        "lunch_recess",
        "behavior",
        "academic_support",
        "other"
      ]
    },
    "activity": {
      "type": "string"
    },
    "objective_observation": {
      "type": "string"
    },
    "support_level": {
      "type": "string",
      "enum": [
        "independent",
        "visual_prompt",
        "verbal_prompt",
        "model",
        "gestural_prompt",
        "partial_physical",
        "physical_assistance",
        "other"
      ]
    },
    "frequency": {
      "type": "number"
    },
    "duration_minutes": {
      "type": "number"
    },
    "student_response": {
      "type": "string"
    },
    "follow_up": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "complete"
      ],
      "default": "complete"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "not_sent",
        "submitted",
        "reviewed",
        "returned"
      ],
      "default": "not_sent"
    },
    "submitted_at": {
      "type": "string"
    },
    "review_note": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "para_user_id": {
      "type": "string"
    },
    "reviewer_user_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "parent_note_id": {
      "type": "string"
    },
    "immutable_after_submit": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "student_id",
    "date",
    "objective_observation"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.para_user_id": "{{user.id}}"
        },
        {
          "data.reviewer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.para_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.para_user_id": "{{user.id}}"
        },
        {
          "data.reviewer_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.para_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}