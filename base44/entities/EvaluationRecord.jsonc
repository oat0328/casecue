{
  "name": "EvaluationRecord",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "evaluation_type": {
      "type": "string",
      "enum": [
        "initial",
        "reevaluation",
        "met",
        "other"
      ],
      "title": "Evaluation Type"
    },
    "consent_date": {
      "type": "string",
      "format": "date",
      "title": "Consent Date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "meeting_date": {
      "type": "string",
      "format": "date",
      "title": "Meeting Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "consent_pending",
        "in_progress",
        "reports_pending",
        "meeting_ready",
        "completed"
      ],
      "default": "planned",
      "title": "Status"
    },
    "assessments": {
      "type": "string",
      "title": "Assessments / Areas"
    },
    "evaluators": {
      "type": "string",
      "title": "Evaluators"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "eligibility_review": {
      "type": "string",
      "title": "Eligibility Review Notes"
    }
  },
  "required": [
    "student_id",
    "organization_id",
    "evaluation_type"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}