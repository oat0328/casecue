{
  "name": "TeacherCorrection",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "grading_run_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "problem_number": {
      "type": "string"
    },
    "field_changed": {
      "type": "string"
    },
    "original_value": {
      "type": "string"
    },
    "corrected_value": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "handwriting_read_error",
        "problem_extraction_error",
        "grading_error",
        "partial_credit",
        "accommodation",
        "teacher_judgment",
        "other"
      ],
      "default": "teacher_judgment"
    },
    "corrected_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "grading_run_id",
    "student_id",
    "field_changed"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}