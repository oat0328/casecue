{
  "name": "StateConfig",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "state_code": {
      "type": "string",
      "title": "State Code"
    },
    "pack_name": {
      "type": "string",
      "title": "Configuration Pack"
    },
    "meeting_terms": {
      "type": "object",
      "title": "Meeting / Document Terminology"
    },
    "timeline_notes": {
      "type": "string",
      "title": "Timeline Notes"
    },
    "required_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Required / Local Sections"
    },
    "local_labels": {
      "type": "object",
      "title": "Local Labels"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    }
  },
  "required": [
    "organization_id",
    "state_code"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}