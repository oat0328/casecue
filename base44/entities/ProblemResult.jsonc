{
  "name": "ProblemResult",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "grading_run_id": {
      "type": "string"
    },
    "grading_pass_id": {
      "type": "string"
    },
    "problem_order": {
      "type": "number"
    },
    "problem_number": {
      "type": "string"
    },
    "problem_text": {
      "type": "string"
    },
    "student_answer_raw": {
      "type": "string"
    },
    "expected_answer": {
      "type": "string"
    },
    "earned_points": {
      "type": "number"
    },
    "possible_points": {
      "type": "number"
    },
    "result": {
      "type": "string",
      "enum": [
        "correct",
        "incorrect",
        "partial",
        "blank",
        "unreadable",
        "needs_review"
      ]
    },
    "deterministic": {
      "type": "boolean",
      "default": false
    },
    "requires_teacher_review": {
      "type": "boolean",
      "default": false
    },
    "note": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "grading_run_id",
    "grading_pass_id"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}