{
  "name": "SessionLog",
  "type": "object",
  "properties": {
    "goal_area": {
      "type": "string",
      "title": "Goal Area"
    },
    "provider": {
      "type": "string",
      "title": "Provider"
    },
    "student_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Student IDs"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "minutes": {
      "type": "number",
      "title": "Minutes"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "pull-out",
        "push-in",
        "consultation"
      ],
      "default": "pull-out",
      "title": "Delivery"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    }
  },
  "required": [
    "goal_area",
    "student_ids",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.organization_id": "{{user.data.organization_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}