{
  "name": "SpeechSession",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "provider_user_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "minutes": {
      "type": "number"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "individual",
        "group"
      ],
      "default": "individual"
    },
    "skill": {
      "type": "string"
    },
    "trials_correct": {
      "type": "number"
    },
    "trials_total": {
      "type": "number"
    },
    "cueing": {
      "type": "string"
    },
    "observation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "complete"
      ],
      "default": "complete"
    }
  },
  "required": [
    "provider_user_id",
    "student_id",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.provider_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}