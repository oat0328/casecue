{
  "name": "StudentNote",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "title": "Organization ID"
    },
    "student_id": {
      "type": "string",
      "title": "Student ID"
    },
    "author_id": {
      "type": "string",
      "title": "Author ID"
    },
    "author_name": {
      "type": "string",
      "title": "Author"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
    },
    "time": {
      "type": "string",
      "title": "Time"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "parent_contact",
        "phone_call",
        "email_communication",
        "meeting_note",
        "student_observation",
        "behavior_note",
        "goal_progress",
        "service_delivery",
        "accommodation_note",
        "compliance_note",
        "iep_preparation",
        "iep_meeting",
        "follow_up",
        "general"
      ],
      "default": "general",
      "title": "Record Type"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "title": "Priority"
    },
    "attachment_url": {
      "type": "string",
      "title": "Private Attachment"
    },
    "original_filename": {
      "type": "string",
      "title": "Original File Name"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date",
      "title": "Follow-Up Date"
    },
    "follow_up_status": {
      "type": "string",
      "enum": [
        "none",
        "open",
        "completed",
        "dismissed"
      ],
      "default": "none",
      "title": "Follow-Up Status"
    },
    "linked_area": {
      "type": "string",
      "enum": [
        "none",
        "present_levels",
        "goals",
        "accommodations",
        "behavior_plan",
        "services",
        "progress_monitoring",
        "meeting_preparation",
        "compliance_tracking"
      ],
      "default": "none",
      "title": "Linked IEP Area"
    },
    "linked_record_id": {
      "type": "string",
      "title": "Linked Record ID"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "voice",
        "scan",
        "upload",
        "meeting",
        "email",
        "system"
      ],
      "default": "manual",
      "title": "Source"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deleted"
      ],
      "default": "active",
      "title": "Status"
    },
    "deleted_at": {
      "type": "string",
      "title": "Deleted At"
    },
    "deleted_by": {
      "type": "string",
      "title": "Deleted By"
    },
    "last_modified_by": {
      "type": "string",
      "title": "Last Modified By"
    }
  },
  "required": [
    "organization_id",
    "student_id",
    "author_id",
    "date",
    "title",
    "description"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "$and": [
        {
          "data.organization_id": "{{user.data.organization_id}}"
        },
        {
          "data.author_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}