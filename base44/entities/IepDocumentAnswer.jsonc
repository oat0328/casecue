{
  "name": "IepDocumentAnswer",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "student_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "page_number": {
      "type": "number"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "documented",
        "not_answered",
        "needs_review"
      ],
      "default": "documented"
    }
  },
  "required": [
    "student_id",
    "document_id",
    "question",
    "answer"
  ],
  "rls": {
    "read": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "create": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "update": {
      "data.organization_id": "{{user.data.organization_id}}"
    },
    "delete": {
      "data.organization_id": "{{user.data.organization_id}}"
    }
  }
}