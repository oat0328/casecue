{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * 1-5",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Deadline Alerts",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_deadline_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_alerts": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDeadlineAlerts"
          },
          "then": "end",
          "x-base44": {
            "title": "Send deadline alerts",
            "description": "Email each teacher their deadline digest"
          }
        }
      }
    ]
  },
  "description": "Emails each teacher a digest of upcoming IEP annual reviews and reevaluations on weekday mornings"
}